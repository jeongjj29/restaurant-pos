# Copy this file to the ignored repository-root .env for the local
# compose.production.yml smoke stack. Never commit the populated .env.

# Required: fill both values before starting Compose.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Host port for the local smoke stack.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Match these to the deployment topology and measured capacity.
# TRUSTED_HOSTS=pos.example.com
# HEALTHCHECK_HOST=pos.example.com
TRUST_PROXY_COUNT=0
WEB_CONCURRENCY=2
GUNICORN_THREADS=2

# Safe startup defaults. See DEPLOYMENT.md before changing them.
RUN_MIGRATIONS=true
SEED_DATABASE=false
ALLOW_DEMO_SEED=false
